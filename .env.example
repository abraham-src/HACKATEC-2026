# ─────────────────────────────────────────────────────────────
# SIMU · CDMX — variables de entorno
# Copia este archivo a .env antes de `docker compose up`.
# Los valores son SOLO para desarrollo local. Cámbialos en cualquier
# entorno compartido. Usa contraseñas sin caracteres especiales de URL
# (@ : / ? #) porque se interpolan en DATABASE_URL.
# ─────────────────────────────────────────────────────────────

# PostgreSQL + PostGIS
POSTGRES_USER=simu
POSTGRES_PASSWORD=simu_dev_password
POSTGRES_DB=simu
POSTGRES_PORT=5432

# Solo para correr la API/seed fuera de Docker (npm run dev:api).
# Dentro de Docker, compose construye su propia URL hacia el host "postgres".
DATABASE_URL=postgresql://simu:simu_dev_password@localhost:5432/simu?schema=public

# API
API_PORT=3000
LOG_LEVEL=info
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Contraseña de los 4 usuarios demo creados por el seed
SEED_DEMO_PASSWORD=simu2026

# Web (puerto publicado en el host)
WEB_PORT=5173

# Simulador (fuera de Docker apunta a la API local)
SIMULATOR_PORT=4000
SIMULATOR_API_URL=http://localhost:3000

# Servicio de IA opcional (docker compose --profile ai up).
# Vacío = la API usa su mock interno.
AI_SERVICE_URL=
